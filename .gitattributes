# ONFLY: byte-exactness is a requirement (FR-PRP-09, IR-NET-01, ACC-5).
# Git must never rewrite line endings or "fix" content in this repository.
* text=auto eol=lf

# Binary artifacts: never touched.
*.docx  binary
*.bin   binary
*.dat   binary
*.net   binary
*.tape  binary
*.aws   binary

# Generated layout files and fixed-column datasets are byte-sensitive.
*.cpy   text eol=lf
*.jcl   text eol=lf

# Vendored third-party sources are stored byte-for-byte as shipped upstream.
# D-35 and third_party/MANIFEST.md both claim this tree matches the released
# archive exactly; normalising line endings would silently make that false.
third_party/** -text
