# Build output
build/
*.o
*.obj
*.exe
*.a
*.lib

# Python
__pycache__/
*.pyc
.venv/

# Editor / OS
.DS_Store
Thumbs.db
*.swp

# Claude Code working state
.claude/worktrees/

# Vendored archives: extracted contents are committed, digests are in third_party/MANIFEST.md
third_party/*.zip

# MaleCNS data files: large, public, digests recorded in data/malecns/MANIFEST.md
data/malecns/*.feather

# Emitted network files: large binaries, digests in data/networks/MANIFEST.json
data/networks/*.bin

# Full-brain run outputs: large, regenerable from tools/fullbrain.sh
data/fullbrain/*.txt

# D-80: upstream's own build/<target>/Makefile and platform.h under third_party
# are vendored SOURCE, not build output -- `make testfloat` reads them.  The
# `build/` rule above swallowed them, so a fresh clone could not rebuild the
# TestFloat generator and TT-02 was reproducible only in the checkout where the
# archive was first extracted.  Git refuses to re-include a file whose parent
# directory is excluded, so every level of the path is re-included in turn and
# then re-excluded, leaving exactly these two filenames tracked.  The .o, .a
# and .exe products stay ignored.
!third_party/*/build/
third_party/*/build/*
!third_party/*/build/*/
third_party/*/build/*/*
!third_party/*/build/*/Makefile
!third_party/*/build/*/platform.h

# Raincode probe build products (tests/raincode/README.md, VL-37).
# Generated by cobrc and rcbms; never edited, never committed.
tests/raincode/*.dll
tests/raincode/*.pdb
tests/raincode/bmsout/

# INTERCOMM-derived material and anything else that must not be
# distributed under this repository MIT licence (D-132, VL-38).
# The Phase G INTERCOMM shim lives here and is never committed.
local/

# Gate G2 transport artifacts: generated by tools/mkaws.py from the
# network file and regenerable; the tape images are large binaries.
data/transport/

# D-164: Shiu et al. FlyWire 630 inputs and re-run spike outputs are large and
# regenerable; digests live in reference/shiu/MANIFEST.json and results/MANIFEST.json
reference/shiu/data/
reference/shiu/results/data/

# SR-CAL-03 calibration: candidate networks (300 MB each) and the signed-count
# cache are regenerable by prep/calibrate.py; the search log is committed.
data/calibration/*.bin
data/calibration/*.npz
data/calibration/tmp/
data/calibration/*.npy

# D-315: transient job status files, rewritten every tick
data/progress/

# .NET build output from the Phase G transaction (D-394, D-398).
# The sources live in cics/; dotnet writes obj/ and bin/ beside them.
cics/obj/
cics/bin/
